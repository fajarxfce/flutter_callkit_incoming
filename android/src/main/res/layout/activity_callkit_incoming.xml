<?xml version="1.0" encoding="utf-8"?>
<!-- Native incoming call, Figma 118:1837. Host apps can override the backdrop. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/bg_incoming_call" />

    <LinearLayout
        android:id="@+id/incomingCallContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1.5" />

        <include layout="@layout/layout_incoming_caller" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <include layout="@layout/layout_incoming_avatar" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="3" />

        <com.hiennv.flutter_callkit_incoming.widgets.CallSwipeView
            android:id="@+id/callSwipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</FrameLayout>
